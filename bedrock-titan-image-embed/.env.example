# Copy to .env and fill in. .env is gitignored — never commit it.

# --- AWS Bedrock (required) ---
# Bedrock API key (Bedrock console -> API keys) and the region with model access.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here
AWS_REGION=us-east-1

# --- Db2 (only when running remotely from the Db2 host) ---
# Leave DB2_HOSTNAME unset to use a local trusted connection on the Db2 box.
# DB2_DATABASE=SAMPLE
# DB2_HOSTNAME=db2host.example.com
# DB2_PORT=50000
# DB2_UID=db2inst1
# DB2_PWD=your-db2-password
