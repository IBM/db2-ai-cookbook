# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored — never commit real credentials.

# --- Db2 connection -------------------------------------------------------
# DB2_PORT must match the instance's SVCENAME — it is often NOT 50000; find it with
# `db2 get dbm cfg | grep SVCENAME` rather than assuming.
# DB2_DATABASE must match `CONNECT TO SAMPLE` in scripts/1_ingest.sql and
# 2_search.sql — change it in both places or neither.
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=sample
DB2_USER=db2inst1
DB2_PASSWORD=your-db2-password

# --- Embeddings -----------------------------------------------------------
# No API keys: embeddings are generated by a LOCAL llama.cpp server
# (bge-small-en-v1.5) via Db2's PROVIDER OPENAI model. The endpoint/model are
# set directly in scripts/1_ingest.sql. See docs/local-embeddings.md.

# --- Object names: FIXED, not configurable here ---------------------------
# The schema/table are MYSCHEMA.CHUNKS, hardcoded in scripts/1_ingest.sql and
# 2_search.sql. A .sql file cannot read this .env, so setting a schema/table
# override here would apply to the Python engine but NOT to the SQL that creates
# the table — ingest would build MYSCHEMA.CHUNKS while every query looked for
# yours, failing later with a confusing "undefined name". So there is no knob.
# To rename: edit the .sql scripts (and src/hybrid_search/core.py) together.

# --- Db2 instance owner (for local text-search admin / shell wrappers) ----
DB2_INSTANCE_OWNER=db2inst1

# --- Hybrid fusion knobs (optional; these ARE the shipped defaults) -------
# These match src/hybrid_search/core.py and scripts/2_search.sql, so the system
# behaves identically whether or not you have a .env.
#
# They are CORPUS-SPECIFIC. 0.2/0.8 was chosen on the shipped audiobook corpus by
# the one-standard-error rule over a 5-fold-CV weight sweep (see docs/eval-results.md).
# On a different corpus, re-tune: `DB2_HOST=local python scripts/eval.py`.
#
# Only the RATIO of W_LEX:W_VEC matters — each leg is max-normalized before fusing.
# VEC_GATE drops the vector leg when its best cosine is below the threshold (useful
# when exact codes/IDs embed to noise); 0.0 disables gating.
# POOL = candidates per leg before fusing. >= corpus size means exhaustive (never
# truncates); lower it only for speed on a large corpus.
HYBRID_W_LEX=0.3
HYBRID_W_VEC=0.7
HYBRID_VEC_GATE=0.0
HYBRID_LEX_GATE=0.0
HYBRID_POOL=100

# --- Query understanding (scripts/query-understanding) --------------------
# NOTE: the extractive QU_LEXICAL cleaner was REMOVED from the search path; both legs
# now receive the raw query (core.keywords() drops English stopwords for CONTAINS).
# Generative expansion via local Qwen is gated by QU_MODE and OFF by default.
#   off = cleaner only (no LLM) | gated = route gate | crag = confidence gate
QU_MODE=off
QU_SIM_GATE=0.60

# --- Reranking (post-fusion cross-encoder, Search tab only) ---------------
# App-layer stage on top of Db2 fusion; OFF by default. Needs a reranker server
# (llama-server --reranking on RERANK_URL). See scripts/rerank/.
RERANK_ON=0
RERANK_URL=http://127.0.0.1:8087
RERANK_MODEL=reranker
RERANK_N=20
RERANK_K=3
RERANK_TIMEOUT=8.0

# --- Local model serving (paths/ports) ------------------------------------
# Read by the start scripts (0_start-services.sh, scripts/*/start_*_server.sh) from
# the ENVIRONMENT — export these before running, or just edit the script defaults.
# Listed here so all machine-specific config lives in one place. Defaults shown.
# LLAMA_CPP_DIR=$HOME/llama.cpp
# BGE_GGUF=$HOME/models/bge-small-en-v1.5/bge-small-en-v1.5-q8_0.gguf
# EMBED_PORT=8085
# RERANK_GGUF=$HOME/models/bge-reranker-v2-m3/bge-reranker-v2-m3-Q4_K_M.gguf
# RERANK_PORT=8087
# OPENSEARCH_HOME=/opt/opensearch
# OPENSEARCH_PORT=9200
