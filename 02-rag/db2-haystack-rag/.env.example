# --- Local Db2 (12.1.2+ for the native VECTOR type) ---
DB2_DATABASE=SAMPLE
DB2_HOSTNAME=localhost
DB2_PORT=50000
DB2_USERNAME=db2inst1
DB2_PASSWORD=your_db2_password
DB2_TABLE_NAME=HAYSTACK_DOCUMENTS

# --- llama.cpp, OpenAI-compatible endpoints (scripts/llama-servers.sh) ---
# One llama-server process serves one model, so embeddings and chat are two ports.
EMBED_BASE_URL=http://127.0.0.1:8081/v1
EMBED_MODEL=bge-small-en-v1.5

CHAT_BASE_URL=http://127.0.0.1:8080/v1
CHAT_MODEL=qwen2.5-3b-instruct
