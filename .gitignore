# --- Secrets: never commit real credentials ---
# `.env.*` matters as much as `.env` — a `.env.bak.*` copy once slipped past a bare
# `.env` rule and published a live Db2 password. Commit .env.example instead.
.env
.env.*
!.env.example
*.key
*.pem
*credentials*
*secret*
# The Db2 Jupyter magic (%sql CONNECT CREDENTIALS) caches credentials to a pickle
# next to the notebook. A rule covering only .env lets that copy through.
*.pickle

# Python virtual environments — multi-GB and machine-specific (absolute paths baked in)
.venv/
venv/

# Node dependencies — same reasoning, and larger. A recipe's own frontend/.gitignore
# may also cover this; don't rely on it, because trimming that file would silently
# make ~300 MB of node_modules committable.
node_modules/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/
.Python
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime logs and generated artifacts
server.log
*.log
logs/
cache/
out/
scratch/
tmp/
*.npy

# Model weights — GB-scale, always downloaded rather than committed
*.gguf

# Infinity on-disk cache
.infinity_cache/

# Backups / editor & session junk
*.bak
*.bak.*
*.orig
*.rej
*~
*.swp
*.swo
.idea/
.vscode/

# Core dumps (e.g. from the AVX2 debugging). Match `core` and `core.<pid>` only —
# a bare `core.*` also swallows source files like core.py.
core
core.[0-9]*

# OS noise
.DS_Store
Thumbs.db

# scratch file written by loadvectors.sh
temp.sql

# Db2 Jupyter magic — every notebook that needs it downloads it from
# github.com/IBM/db2-jupyter at runtime. Never vendor it.
db2.ipynb
