# Copy to .env and fill in. .env is gitignored — never commit it.
#
# The Db2 Jupyter magic caches these to db2creds.pickle next to the notebook when
# you run `%sql CONNECT CREDENTIALS db2creds`. The cookbook's root .gitignore
# covers *.pickle for exactly that reason; don't remove that rule.

# --- Db2 ---
database=SAMPLE
hostname=localhost
port=50000
protocol=tcpip
uid=db2inst1
pwd=your-db2-password

# --- watsonx.ai (answer generation) ---
# API key: https://cloud.ibm.com/iam/apikeys
# Project ID: your watsonx.ai project → Manage → General
WATSONX_APIKEY=your-watsonx-api-key
WATSONX_PROJECT=your-watsonx-project-id
