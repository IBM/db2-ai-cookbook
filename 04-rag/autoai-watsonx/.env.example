# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Only watsonx.ai credentials are needed. AutoAI RAG uploads its training and
# evaluation files as watsonx.ai *data assets*, which live in the storage already
# attached to your project — no separate Cloud Object Storage bucket or
# connection ID is required.
WATSONX_APIKEY=your-watsonx-api-key
WATSONX_PROJECT=your-watsonx-project-id
