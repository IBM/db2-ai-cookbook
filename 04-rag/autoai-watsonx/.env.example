# watsonx.ai — https://dataplatform.cloud.ibm.com/  →  API key and project ID
WATSONX_APIKEY=REPLACE_WITH_YOUR_WATSONX_AI_RUNTIME_API_KEY
WATSONX_PROJECT=REPLACE_WITH_YOUR_WATSONX_AI_PROJECT_ID

# IBM Cloud Object Storage — AutoAI RAG reads its training and evaluation
# data from a COS bucket, so a connection asset is required.
COS_CONNECTION_ID=REPLACE_WITH_YOUR_COS_CONNECTION_ASSET_ID
COS_BUCKET=REPLACE_WITH_YOUR_COS_BUCKET_NAME
