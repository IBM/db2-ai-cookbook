# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Db2 ---
DB_NAME=SAMPLE
DB_HOST=localhost
DB_PORT=50000
DB_PROTOCOL=tcpip
DB_USER=db2inst1
DB_PASSWORD=your-db2-password

# --- Local models (absolute paths to the GGUF files from Quick Setup step 2) ---
EMBEDDING_MODEL_PATH=/path/to/granite-embedding-30m-english-Q6_K.gguf
LLM_PATH=/path/to/qwen2.5-3b-instruct-q4_k_m.gguf
