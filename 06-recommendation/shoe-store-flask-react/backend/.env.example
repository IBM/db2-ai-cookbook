# Copy to .env and fill in. .env is gitignored — never commit it.
# These five keys are read by config.py and assembled into an ibm_db DSN in app/db.py.
# DB_PORT must match the instance's SVCENAME: db2 get dbm cfg | grep -i svcename
DB_NAME=SAMPLE
DB_HOST=localhost
DB_PORT=50000
DB_USER=REPLACE_WITH_YOUR_DB2_USER
DB_PASSWORD=REPLACE_WITH_YOUR_DB2_PASSWORD
