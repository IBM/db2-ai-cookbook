# Copy to .env and fill in. .env is gitignored — never commit it.
#
# The Db2 Jupyter magic caches these to db2connect.pickle next to the notebook when
# you run `%sql CONNECT CREDENTIALS db2creds`. The cookbook's root .gitignore
# covers *.pickle for exactly that reason; don't remove that rule.

# --- Db2 ---
# Lowercase keys: `CONNECT CREDENTIALS` reads them verbatim, and its connection
# string is always TCP/IP — a local instance still needs all five.
database=SAMPLE
hostname=localhost
port=50000
protocol=tcpip
uid=REPLACE_WITH_YOUR_DB2_USER
pwd=REPLACE_WITH_YOUR_DB2_PASSWORD

# --- watsonx.ai (embeddings) ---
# API key:    https://cloud.ibm.com/iam/apikeys
# Project ID: your watsonx.ai project → Manage → General
WATSONX_APIKEY=REPLACE_WITH_YOUR_WATSONX_AI_RUNTIME_API_KEY
WATSONX_PROJECT=REPLACE_WITH_YOUR_WATSONX_AI_PROJECT_ID
